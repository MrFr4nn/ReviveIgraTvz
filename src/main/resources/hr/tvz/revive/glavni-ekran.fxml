<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.tvz.revive.kontroler.GlavniKontroler"
            prefHeight="820.0" prefWidth="1300.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="6" alignment="CENTER" fx:id="panelZaglavlja" style="-fx-background-color: #1f2d3d; -fx-padding: 18 18 14 18;">
            <Label text="REVIVE - Obnova Civilizacije" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="labelaTrenutniIgrac" text="Na potezu: -" style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 4 14; -fx-background-color: #2ecc71; -fx-background-radius: 8;"/>
            <Label fx:id="labelaRunda" text="Runda 1/5" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="270" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #dcdfe3; -fx-border-width: 0 2 0 0;">
            <Label text="IGRAC 1 (zeleni)" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;"/>
            <Label fx:id="labelaStanjeIgrac1" text="-" wrapText="true" style="-fx-font-size: 12px;"/>
            <Separator/>
            <Label text="Ruka karata" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <ListView fx:id="listaKarataIgrac1" prefHeight="200" style="-fx-font-size: 11px;"/>
        </VBox>
    </left>

    <right>
        <VBox spacing="10" prefWidth="270" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #dcdfe3; -fx-border-width: 0 0 0 2;">
            <Label text="IGRAC 2 (plavi)" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e90ff;"/>
            <Label fx:id="labelaStanjeIgrac2" text="-" wrapText="true" style="-fx-font-size: 12px;"/>
            <Separator/>
            <Label text="Ruka karata" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <ListView fx:id="listaKarataIgrac2" prefHeight="200" style="-fx-font-size: 11px;"/>
        </VBox>
    </right>

    <center>
        <VBox spacing="14" alignment="TOP_CENTER" style="-fx-padding: 16 30 16 30;">

            <VBox spacing="6" alignment="CENTER">
                <Label text="Permafrost ploca" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
                <Label text="Zeleno = Igrac 1, Plavo = Igrac 2, Sivo = slobodno" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                <StackPane>
                    <GridPane fx:id="mrezaPermafrosta" hgap="10" vgap="10" alignment="CENTER"/>
                    <Pane fx:id="slojPoruka" mouseTransparent="true" pickOnBounds="false"/>
                </StackPane>
            </VBox>

            <Separator prefWidth="500"/>

            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="gumbOdigrajKartu" text="Odigraj odabranu kartu" onAction="#odigrajOdabranuKartu" prefWidth="260" prefHeight="38"
                        style="-fx-background-color: #1f2d3d; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Button fx:id="gumbPredajPotez" text="Predaj potez" onAction="#predajPotez" prefWidth="160" prefHeight="38"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <Label text="ILI postavi radnika na ploci (plati ulaznu cijenu):" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>

            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Button fx:id="gumbExplorer" text="EXPLORER" onAction="#odaberiExplorer" prefWidth="200" prefHeight="42"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Button fx:id="gumbBuilder" text="BUILDER" onAction="#odaberiBuilder" prefWidth="200" prefHeight="42"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Button fx:id="gumbScholar" text="SCHOLAR" onAction="#odaberiScholar" prefWidth="200" prefHeight="42"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Button fx:id="gumbScientist" text="SCIENTIST" onAction="#odaberiScientist" prefWidth="200" prefHeight="42"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="labelaOdabranaAkcija" text="" wrapText="true" maxWidth="500"
                   style="-fx-font-size: 12px; -fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
            <Label fx:id="labelaPorukaPoteza" text="" wrapText="true" maxWidth="500"
                   style="-fx-font-size: 12px; -fx-text-fill: #c0392b; -fx-font-weight: bold;"/>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #dcdfe3; -fx-border-width: 2 0 0 0;">
            <Button fx:id="gumbSpremiIgru" text="Spremi igru" onAction="#spremiIgru" prefWidth="150" prefHeight="32"/>
        </HBox>
    </bottom>

</BorderPane>