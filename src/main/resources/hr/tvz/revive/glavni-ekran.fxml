<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.tvz.revive.kontroler.GlavniKontroler"
            prefHeight="780.0" prefWidth="1180.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="8" alignment="CENTER" style="-fx-background-color: #1f2d3d; -fx-padding: 20 18 16 18;">
            <Label text="REVIVE - Obnova Civilizacije" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <VBox spacing="4" alignment="CENTER">
                <Label fx:id="labelaTrenutniIgrac" text="Na potezu: -" style="-fx-font-size: 15px; -fx-text-fill: #ecf0f1; -fx-font-weight: bold;"/>
                <Label fx:id="labelaRunda" text="Runda: 1 / 5" style="-fx-font-size: 13px; -fx-text-fill: #95a5a6;"/>
            </VBox>
            <Label text="Tijek poteza:  1) Odaberi kartu iz ruke   →   2) Odigraj potez   →   3) Zavrsi potez"
                   style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </top>

    <left>
        <VBox spacing="12" prefWidth="320" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="Ruka karata" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <ListView fx:id="listaRukaKarata" prefHeight="190" style="-fx-font-size: 13px;"/>

            <Label fx:id="labelaOdabranaAkcija" text="Odaberi kartu iz ruke da vidis koji radnik ide uz nju."
                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #2980b9; -fx-font-weight: bold;"/>

            <Separator/>

            <Label text="Status radnika ove runde" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <Label fx:id="labelaStatusRadnika" text="" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>

            <Separator/>

            <Button fx:id="gumbOdigrajPotez" text="Odigraj potez" onAction="#odigrajPotez" prefWidth="300" prefHeight="40"
                    style="-fx-background-color: #1f2d3d; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Button fx:id="gumbZavrsiPotez" text="Zavrsi potez" onAction="#zavrsiPotez" prefWidth="300" prefHeight="40"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>

            <Label fx:id="labelaPorukaPoteza" text="" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #c0392b; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="16" alignment="CENTER" style="-fx-padding: 24;">
            <Label text="Permafrost ploca" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <Label text="Kristal karta = Explorer: klikni polje da ga otopis" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
            <GridPane fx:id="mrezaPermafrosta" hgap="12" vgap="12" alignment="CENTER"/>
        </VBox>
    </center>

    <right>
        <VBox spacing="10" prefWidth="270" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="Stanje igraca" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <Label fx:id="labelaResursiIgrac1" text="Igrac 1: -" wrapText="true" style="-fx-font-size: 12px;"/>
            <Label fx:id="labelaResursiIgrac2" text="Igrac 2: -" wrapText="true" style="-fx-font-size: 12px;"/>

            <Separator/>

            <VBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="gumbSpremiIgru" text="Spremi igru" onAction="#spremiIgru" prefWidth="220" prefHeight="34"/>
                <Button fx:id="gumbUcitajIgru" text="Ucitaj igru" onAction="#ucitajIgru" prefWidth="220" prefHeight="34"/>
                <Button fx:id="gumbPrikaziKatalog" text="Katalog radnika" onAction="#prikaziKatalogRadnika" prefWidth="220" prefHeight="34"/>
                <Button fx:id="gumbPrikaziReplay" text="Prikazi replay" onAction="#prikaziReplay" prefWidth="220" prefHeight="34"/>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <Label fx:id="labelaKrajIgre" text="" wrapText="true"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-padding: 14;"/>
    </bottom>

</BorderPane>