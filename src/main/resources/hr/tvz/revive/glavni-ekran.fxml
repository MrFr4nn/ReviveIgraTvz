<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.tvz.revive.kontroler.GlavniKontroler"
            prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="8" alignment="CENTER" style="-fx-background-color: #1f2d3d; -fx-padding: 20 18 16 18;">
            <Label text="REVIVE - Obnova Civilizacije" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <VBox spacing="4" alignment="CENTER">
                <Label fx:id="labelaTrenutniIgrac" text="Na potezu: -" style="-fx-font-size: 15px; -fx-text-fill: #ecf0f1; -fx-font-weight: bold;"/>
                <Label fx:id="labelaRunda" text="Runda: 1 / 5" style="-fx-font-size: 13px; -fx-text-fill: #95a5a6;"/>
            </VBox>
            <Label text="Tijek poteza:  1) Odaberi kartu   →   2) Klikni odgovarajuceg radnika (ili polje za Explorer)   →   potez se odmah odigra"
                   style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </top>

    <left>
        <VBox spacing="14" prefWidth="340" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="Ruka karata" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <ListView fx:id="listaRukaKarata" prefHeight="120" style="-fx-font-size: 12px;"/>

            <Label fx:id="labelaOdabranaAkcija" text="Odaberi kartu iz ruke da vidis koji radnik ide uz nju."
                   wrapText="true" maxWidth="300" style="-fx-font-size: 12px; -fx-text-fill: #2980b9; -fx-font-weight: bold;"/>

            <Separator/>

            <Label text="Radnik za odabranu kartu" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <GridPane hgap="8" vgap="8">
                <Button fx:id="gumbExplorer" text="Explorer" onAction="#odaberiExplorer" prefWidth="145"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Button fx:id="gumbBuilder" text="Builder" onAction="#odaberiOstaloRadnika" prefWidth="145"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Button fx:id="gumbScholar" text="Scholar" onAction="#odaberiOstaloRadnika" prefWidth="145"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Button fx:id="gumbScientist" text="Scientist" onAction="#odaberiOstaloRadnika" prefWidth="145"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <Separator/>

            <Label text="Status radnika ove runde" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <Label fx:id="labelaStatusRadnika" text="" wrapText="true" maxWidth="300"
                   style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-line-spacing: 4;"/>

            <Separator/>

            <Label fx:id="labelaPorukaPoteza" text="" wrapText="true" maxWidth="300"
                   style="-fx-font-size: 12px; -fx-text-fill: #c0392b; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 40 24 24 24;">
            <VBox spacing="8" alignment="CENTER">
                <Label text="Permafrost ploca" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
                <Label text="Kristal karta = Explorer: klikni polje da ga otopis" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
            <GridPane fx:id="mrezaPermafrosta" hgap="14" vgap="14" alignment="CENTER"/>

            <Separator prefWidth="400"/>

            <VBox spacing="10" alignment="CENTER">
                <Label text="Stanje igraca" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
                <Label fx:id="labelaResursiIgrac1" text="Igrac 1: -" style="-fx-font-size: 13px;"/>
                <Label fx:id="labelaResursiIgrac2" text="Igrac 2: -" style="-fx-font-size: 13px;"/>
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="10" prefWidth="220" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="Alati" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <Separator/>
            <Button fx:id="gumbSpremiIgru" text="Spremi igru" onAction="#spremiIgru" prefWidth="180" prefHeight="34"/>
            <Button fx:id="gumbUcitajIgru" text="Ucitaj igru" onAction="#ucitajIgru" prefWidth="180" prefHeight="34"/>
            <Button fx:id="gumbPrikaziKatalog" text="Katalog radnika" onAction="#prikaziKatalogRadnika" prefWidth="180" prefHeight="34"/>
            <Button fx:id="gumbPrikaziReplay" text="Prikazi replay" onAction="#prikaziReplay" prefWidth="180" prefHeight="34"/>
        </VBox>
    </right>

    <bottom>
        <Label fx:id="labelaKrajIgre" text="" wrapText="true"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-padding: 14;"/>
    </bottom>

</BorderPane>