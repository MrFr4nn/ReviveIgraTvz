<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.tvz.revive.kontroler.GlavniKontroler"
            prefHeight="820.0" prefWidth="1300.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="6" alignment="CENTER" style="-fx-background-color: #1f2d3d; -fx-padding: 16 18 12 18;">
            <Label text="REVIVE - Obnova Civilizacije" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="labelaTrenutniIgrac" text="Na potezu: -" style="-fx-font-size: 14px; -fx-text-fill: #ecf0f1; -fx-font-weight: bold;"/>
            <Label fx:id="labelaRunda" text="Runda: 1 / 3" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
        </VBox>
    </top>

    <left>
        <VBox fx:id="panelIgrac1" spacing="10" prefWidth="270" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #dcdfe3; -fx-border-width: 0 2 0 0;">
            <Label text="IGRAC 1" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
            <Label fx:id="labelaStanjeIgrac1" text="-" wrapText="true" style="-fx-font-size: 12px;"/>
            <Separator/>
            <Label text="Ruka karata" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <ListView fx:id="listaKarataIgrac1" prefHeight="220" style="-fx-font-size: 11px;"/>
        </VBox>
    </left>

    <right>
        <VBox fx:id="panelIgrac2" spacing="10" prefWidth="270" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #dcdfe3; -fx-border-width: 0 0 0 2;">
            <Label text="IGRAC 2" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
            <Label fx:id="labelaStanjeIgrac2" text="-" wrapText="true" style="-fx-font-size: 12px;"/>
            <Separator/>
            <Label text="Ruka karata" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
            <ListView fx:id="listaKarataIgrac2" prefHeight="220" style="-fx-font-size: 11px;"/>
        </VBox>
    </right>

    <center>
        <VBox spacing="18" alignment="TOP_CENTER" style="-fx-padding: 20 30 20 30;">

            <VBox spacing="6" alignment="CENTER">
                <Label text="Permafrost ploca" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2d3d;"/>
                <Label text="Kristal karta = Explorer: klikni polje da ga otopis" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                <GridPane fx:id="mrezaPermafrosta" hgap="10" vgap="10" alignment="CENTER"/>
            </VBox>

            <Separator prefWidth="500"/>

            <Label text="Klikni kartu u svojoj ruci, zatim odgovarajuceg radnika" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <Label fx:id="labelaOdabranaAkcija" text="Odaberi kartu iz ruke." wrapText="true" maxWidth="500"
                   style="-fx-font-size: 13px; -fx-text-fill: #2980b9; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Button fx:id="gumbExplorer" text="EXPLORER\ndostupan" onAction="#odaberiExplorer" prefWidth="180" prefHeight="52"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-text-alignment: center;"
                        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Button fx:id="gumbBuilder" text="BUILDER\ndostupan" onAction="#odaberiOstaloRadnika" prefWidth="180" prefHeight="52"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-text-alignment: center;"
                        GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Button fx:id="gumbScholar" text="SCHOLAR\ndostupan" onAction="#odaberiOstaloRadnika" prefWidth="180" prefHeight="52"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-text-alignment: center;"
                        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Button fx:id="gumbScientist" text="SCIENTIST\ndostupan" onAction="#odaberiOstaloRadnika" prefWidth="180" prefHeight="52"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-text-alignment: center;"
                        GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="labelaPorukaPoteza" text="" wrapText="true" maxWidth="500"
                   style="-fx-font-size: 12px; -fx-text-fill: #c0392b; -fx-font-weight: bold;"/>

            <Label fx:id="labelaKrajIgre" text="" wrapText="true" maxWidth="600"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #dcdfe3; -fx-border-width: 2 0 0 0;">
            <Button fx:id="gumbSpremiIgru" text="Spremi igru" onAction="#spremiIgru" prefWidth="150" prefHeight="32"/>
            <Button fx:id="gumbUcitajIgru" text="Ucitaj igru" onAction="#ucitajIgru" prefWidth="150" prefHeight="32"/>
            <Button fx:id="gumbPrikaziKatalog" text="Reflection katalog" onAction="#prikaziKatalogRadnika" prefWidth="150" prefHeight="32"/>
            <Button fx:id="gumbPrikaziReplay" text="Prikazi replay" onAction="#prikaziReplay" prefWidth="150" prefHeight="32"/>
        </HBox>
    </bottom>

</BorderPane>