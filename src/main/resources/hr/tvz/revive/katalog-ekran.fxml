<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.tvz.revive.kontroler.KontrolerKatalog"
            prefHeight="600.0" prefWidth="560.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <Label text="Reflection katalog - dinamička analiza modela" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14;"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: white;">
            <Label fx:id="labelaKatalog" text="" wrapText="true" style="-fx-font-size: 11px; -fx-font-family: 'Consolas'; -fx-padding: 12;"/>
        </ScrollPane>
    </center>

    <bottom>
        <Button text="Zatvori" onAction="#zatvoriProzor" prefWidth="120" prefHeight="32" style="-fx-margin: 10;"/>
    </bottom>

</BorderPane>